@page "/"

@using LowlandTech.Foundry.PluginCore.Attributes
@using LowlandTech.Foundry.PluginCore.Models

@attribute [MenuItem(Title = "Home", Icon = Icons.Material.Filled.Home, Location = MenuLocation.Sidebar, Order = 0)]

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Welcome to Foundry</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    This is a plugin-based Blazor application. Navigation is dynamically generated from plugin assemblies.
</MudText>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Features</MudText>
    <MudList T="string">
        <MudListItem Icon="@Icons.Material.Filled.Extension">
            Plugins as Razor Class Libraries
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.Menu">
            Attribute-based menu configuration
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.Dashboard">
            Dynamic layout switching per page
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.Palette">
            MudBlazor UI components
        </MudListItem>
    </MudList>
</MudPaper>
