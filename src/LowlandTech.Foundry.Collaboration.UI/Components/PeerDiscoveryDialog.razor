@namespace LowlandTech.Foundry.Collaboration.UI.Components

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" />
            <MudText Typo="Typo.h6">Discover Peers</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            @* LAN Discovery Tab *@
            <MudTabPanel Text="Local Network" Icon="@Icons.Material.Filled.Wifi">
                <MudStack Spacing="4">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Scanning local network for peers...
                        </MudText>
                        @if (IsScanning)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudTooltip Text="Refresh">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                               Size="Size.Small"
                                               OnClick="ScanLocalNetwork" />
                            </MudTooltip>
                        }
                    </div>

                    @if (LocalPeers != null && LocalPeers.Any())
                    {
                        <MudList T="DiscoveredPeer" Dense="true" Class="peer-list">
                            @foreach (var peer in LocalPeers)
                            {
                                <MudListItem T="DiscoveredPeer" @key="peer.PeerId">
                                    <div class="d-flex align-center gap-3 py-1">
                                        <MudAvatar Size="Size.Medium" Color="Color.Primary">
                                            @GetInitials(peer.DisplayName)
                                        </MudAvatar>
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.body1">@peer.DisplayName</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @peer.Address
                                            </MudText>
                                        </div>
                                        @if (peer.TrustLevel != TrustLevel.Unknown)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@GetTrustColor(peer.TrustLevel)"
                                                     Variant="Variant.Outlined">
                                                @peer.TrustLevel
                                            </MudChip>
                                        }
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="() => ConnectToPeer(peer)"
                                                   Disabled="@(peer.IsConnecting || peer.IsConnected)">
                                            @if (peer.IsConnecting)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Connecting</span>
                                            }
                                            else if (peer.IsConnected)
                                            {
                                                <span>Connected</span>
                                            }
                                            else
                                            {
                                                <span>Connect</span>
                                            }
                                        </MudButton>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else if (!IsScanning)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No peers found on the local network. Make sure other peers are running and on the same network.
                        </MudAlert>
                    }
                </MudStack>
            </MudTabPanel>

            @* WAN Discovery Tab *@
            <MudTabPanel Text="Internet" Icon="@Icons.Material.Filled.Public">
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Connect to peers over the internet using their Peer ID or a signaling server.
                    </MudText>

                    <MudTextField @bind-Value="_peerIdInput"
                                  Label="Peer ID"
                                  Placeholder="Enter peer ID or paste invite link"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.ContentPaste"
                                  OnAdornmentClick="PasteFromClipboard" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="ConnectByPeerId"
                               Disabled="@(string.IsNullOrWhiteSpace(_peerIdInput))"
                               FullWidth="true">
                        Connect
                    </MudButton>

                    <MudDivider Class="my-2" />

                    <MudText Typo="Typo.subtitle2">Your Peer ID</MudText>
                    <div class="d-flex align-center gap-2">
                        <MudTextField Value="@LocalPeerId"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined"
                                      Class="flex-grow-1" />
                        <MudTooltip Text="Copy to clipboard">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           OnClick="CopyPeerId" />
                        </MudTooltip>
                        <MudTooltip Text="Share">
                            <MudIconButton Icon="@Icons.Material.Filled.Share"
                                           OnClick="SharePeerId" />
                        </MudTooltip>
                    </div>

                    @if (RemotePeers != null && RemotePeers.Any())
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4">Online Peers</MudText>
                        <MudList T="DiscoveredPeer" Dense="true">
                            @foreach (var peer in RemotePeers)
                            {
                                <MudListItem T="DiscoveredPeer" @key="peer.PeerId">
                                    <div class="d-flex align-center gap-3">
                                        <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                            @GetInitials(peer.DisplayName)
                                        </MudAvatar>
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.body2">@peer.DisplayName</MudText>
                                        </div>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="() => ConnectToPeer(peer)"
                                                   Disabled="@(peer.IsConnecting || peer.IsConnected)">
                                            @(peer.IsConnected ? "Connected" : "Connect")
                                        </MudButton>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudStack>
            </MudTabPanel>

            @* Invites Tab *@
            <MudTabPanel Text="Invites" Icon="@Icons.Material.Filled.Mail" BadgeData="@_pendingInvites" BadgeColor="Color.Error">
                <MudStack Spacing="4">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Manage connection invitations from other peers.
                    </MudText>

                    @if (PendingInvites != null && PendingInvites.Any())
                    {
                        <MudList T="PeerInvite" Dense="true">
                            @foreach (var invite in PendingInvites)
                            {
                                <MudListItem T="PeerInvite" @key="invite.Id">
                                    <div class="d-flex align-center gap-3 py-2">
                                        <MudAvatar Size="Size.Medium" Color="Color.Tertiary">
                                            @GetInitials(invite.FromDisplayName)
                                        </MudAvatar>
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.body1">@invite.FromDisplayName</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @invite.Message
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @FormatTimeAgo(invite.ReceivedAt)
                                            </MudText>
                                        </div>
                                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                            <MudButton Color="Color.Success" OnClick="() => AcceptInvite(invite)">
                                                Accept
                                            </MudButton>
                                            <MudButton Color="Color.Error" OnClick="() => DeclineInvite(invite)">
                                                Decline
                                            </MudButton>
                                        </MudButtonGroup>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No pending invitations.
                        </MudAlert>
                    }

                    <MudDivider Class="my-2" />

                    <MudText Typo="Typo.subtitle2">Send Invite</MudText>
                    <MudTextField @bind-Value="_inviteMessage"
                                  Label="Message (optional)"
                                  Placeholder="Hi! Let's collaborate..."
                                  Variant="Variant.Outlined"
                                  Lines="2" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Link"
                               OnClick="CreateInviteLink"
                               FullWidth="true">
                        Create Invite Link
                    </MudButton>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string? LocalPeerId { get; set; }

    [Parameter]
    public IEnumerable<DiscoveredPeer>? LocalPeers { get; set; }

    [Parameter]
    public IEnumerable<DiscoveredPeer>? RemotePeers { get; set; }

    [Parameter]
    public IEnumerable<PeerInvite>? PendingInvites { get; set; }

    [Parameter]
    public bool IsScanning { get; set; }

    [Parameter]
    public EventCallback OnScanLocalNetwork { get; set; }

    [Parameter]
    public EventCallback<DiscoveredPeer> OnConnect { get; set; }

    [Parameter]
    public EventCallback<string> OnConnectByPeerId { get; set; }

    [Parameter]
    public EventCallback<PeerInvite> OnAcceptInvite { get; set; }

    [Parameter]
    public EventCallback<PeerInvite> OnDeclineInvite { get; set; }

    [Parameter]
    public EventCallback<string> OnCreateInvite { get; set; }

    [Parameter]
    public EventCallback<string> OnCopyToClipboard { get; set; }

    [Parameter]
    public EventCallback<string> OnPasteFromClipboard { get; set; }

    [Parameter]
    public EventCallback OnShare { get; set; }

    private string _peerIdInput = "";
    private string _inviteMessage = "";
    private int _pendingInvites => PendingInvites?.Count() ?? 0;

    private async Task ScanLocalNetwork()
    {
        await OnScanLocalNetwork.InvokeAsync();
    }

    private async Task ConnectToPeer(DiscoveredPeer peer)
    {
        peer.IsConnecting = true;
        StateHasChanged();

        await OnConnect.InvokeAsync(peer);
    }

    private async Task ConnectByPeerId()
    {
        if (!string.IsNullOrWhiteSpace(_peerIdInput))
        {
            await OnConnectByPeerId.InvokeAsync(_peerIdInput.Trim());
            _peerIdInput = "";
        }
    }

    private async Task CopyPeerId()
    {
        if (!string.IsNullOrEmpty(LocalPeerId))
        {
            await OnCopyToClipboard.InvokeAsync(LocalPeerId);
        }
    }

    private async Task PasteFromClipboard()
    {
        await OnPasteFromClipboard.InvokeAsync(_peerIdInput);
    }

    private async Task SharePeerId()
    {
        await OnShare.InvokeAsync();
    }

    private async Task AcceptInvite(PeerInvite invite)
    {
        await OnAcceptInvite.InvokeAsync(invite);
    }

    private async Task DeclineInvite(PeerInvite invite)
    {
        await OnDeclineInvite.InvokeAsync(invite);
    }

    private async Task CreateInviteLink()
    {
        await OnCreateInvite.InvokeAsync(_inviteMessage);
        _inviteMessage = "";
    }

    private void Close()
    {
        MudDialog?.Close();
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();

        return name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    private static Color GetTrustColor(TrustLevel level) => level switch
    {
        TrustLevel.Trusted => Color.Success,
        TrustLevel.Verified => Color.Info,
        TrustLevel.Unknown => Color.Default,
        TrustLevel.Blocked => Color.Error,
        _ => Color.Default
    };

    private static string FormatTimeAgo(DateTimeOffset timestamp)
    {
        var diff = DateTimeOffset.UtcNow - timestamp;

        if (diff.TotalSeconds < 60)
            return "just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays}d ago";

        return timestamp.LocalDateTime.ToString("MMM d");
    }
}

