@page "/collaboration"
@inject IDialogService DialogService

@attribute [MenuItem(Title = "Collaboration", Icon = Icons.Material.Filled.Groups, Location = MenuLocation.Sidebar, Order = 10)]

<PageTitle>Collaboration</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudGrid>
        @* Header *@
        <MudItem xs="12">
            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.h4">P2P Collaboration</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Connect with peers and collaborate in real-time
                    </MudText>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.PersonSearch"
                               OnClick="OpenPeerDiscovery">
                        Find Peers
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CreateNewDocument">
                        New Document
                    </MudButton>
                </div>
            </div>
        </MudItem>

        @* Status Cards *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="@(_isConnected ? Color.Success : Color.Default)" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Wifi" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">@(_isConnected ? "Connected" : "Offline")</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Network Status</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">@_onlinePeers</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Online Peers</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Info" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Description" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">@_sharedDocuments</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Shared Documents</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Secondary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">@_activeChatRooms</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Active Chats</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        @* Main Content Area *@
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" GutterBottom="true">Recent Documents</MudText>

                @if (_documents.Any())
                {
                    <MudList T="DocumentInfo" Dense="true">
                        @foreach (var doc in _documents)
                        {
                            <MudListItem @key="doc.Id" OnClick="() => OpenDocument(doc)">
                                <div class="d-flex align-center gap-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.body1">@doc.Title</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @doc.LastModified.ToString("MMM d, yyyy h:mm tt") - @doc.CollaboratorCount collaborators
                                        </MudText>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Color="@(doc.IsShared ? Color.Success : Color.Default)">
                                        @(doc.IsShared ? "Shared" : "Local")
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                        No documents yet. Create a new document to start collaborating!
                    </MudAlert>
                }
            </MudPaper>

            @* Chat Rooms *@
            <MudPaper Class="pa-4 mt-4" Elevation="2">
                <div class="d-flex align-center justify-space-between mb-3">
                    <MudText Typo="Typo.h6">Chat Rooms</MudText>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CreateChatRoom">
                        New Room
                    </MudButton>
                </div>

                @if (_chatRooms.Any())
                {
                    <MudList T="ChatRoomInfo" Dense="true">
                        @foreach (var room in _chatRooms)
                        {
                            <MudListItem @key="room.Id" OnClick="() => OpenChatRoom(room)">
                                <div class="d-flex align-center gap-3">
                                    <MudBadge Content="@room.UnreadCount"
                                              Color="Color.Error"
                                              Overlap="true"
                                              Visible="@(room.UnreadCount > 0)">
                                        <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                                            <MudIcon Icon="@Icons.Material.Filled.Chat" />
                                        </MudAvatar>
                                    </MudBadge>
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.body1">@room.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @room.ParticipantCount participants - @room.LastMessage
                                        </MudText>
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No chat rooms. Create one to start chatting!
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        @* Sidebar - Online Peers *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                <MudText Typo="Typo.h6" GutterBottom="true">Online Peers</MudText>

                <PeerStatusPanel Peers="@_peers" OnPeerClick="OnPeerClick" />
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool _isConnected = false;
    private int _onlinePeers = 0;
    private int _sharedDocuments = 0;
    private int _activeChatRooms = 0;

    private List<DocumentInfo> _documents = new();
    private List<ChatRoomInfo> _chatRooms = new();
    private List<PresenceState> _peers = new();

    protected override void OnInitialized()
    {
        // Demo data - in a real app, this would come from services
        _documents = new List<DocumentInfo>
        {
            new() { Id = Guid.NewGuid(), Title = "Project Notes", LastModified = DateTime.Now.AddHours(-2), CollaboratorCount = 3, IsShared = true },
            new() { Id = Guid.NewGuid(), Title = "Meeting Minutes", LastModified = DateTime.Now.AddDays(-1), CollaboratorCount = 5, IsShared = true },
            new() { Id = Guid.NewGuid(), Title = "Draft Ideas", LastModified = DateTime.Now.AddDays(-3), CollaboratorCount = 1, IsShared = false }
        };

        _chatRooms = new List<ChatRoomInfo>
        {
            new() { Id = Guid.NewGuid(), Name = "General", ParticipantCount = 8, UnreadCount = 3, LastMessage = "Hey everyone!" },
            new() { Id = Guid.NewGuid(), Name = "Development", ParticipantCount = 4, UnreadCount = 0, LastMessage = "PR merged" }
        };

        _peers = new List<PresenceState>
        {
            new() { PeerId = "peer1", DisplayName = "Alice", Status = PresenceStatus.Online },
            new() { PeerId = "peer2", DisplayName = "Bob", Status = PresenceStatus.Away },
            new() { PeerId = "peer3", DisplayName = "Charlie", Status = PresenceStatus.Busy }
        };

        _isConnected = true;
        _onlinePeers = _peers.Count(p => p.Status == PresenceStatus.Online);
        _sharedDocuments = _documents.Count(d => d.IsShared);
        _activeChatRooms = _chatRooms.Count;
    }

    private async Task OpenPeerDiscovery()
    {
        var parameters = new DialogParameters<PeerDiscoveryDialog>
        {
            { x => x.LocalPeerId, "QmYourPeerIdHere..." },
            { x => x.IsScanning, false }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<PeerDiscoveryDialog>("Discover Peers", parameters, options);
    }

    private void CreateNewDocument()
    {
        // Navigate to document editor or create a new document
        var newDoc = new DocumentInfo
        {
            Id = Guid.NewGuid(),
            Title = "Untitled Document",
            LastModified = DateTime.Now,
            CollaboratorCount = 1,
            IsShared = false
        };
        _documents.Insert(0, newDoc);
        _sharedDocuments = _documents.Count(d => d.IsShared);
    }

    private void OpenDocument(DocumentInfo doc)
    {
        // Navigate to document editor
    }

    private void CreateChatRoom()
    {
        var newRoom = new ChatRoomInfo
        {
            Id = Guid.NewGuid(),
            Name = "New Room",
            ParticipantCount = 1,
            UnreadCount = 0,
            LastMessage = ""
        };
        _chatRooms.Insert(0, newRoom);
        _activeChatRooms = _chatRooms.Count;
    }

    private void OpenChatRoom(ChatRoomInfo room)
    {
        // Open chat room
    }

    private void OnPeerClick(PresenceState peer)
    {
        // Handle peer click - start direct message, view profile, etc.
    }

    private sealed class DocumentInfo
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public DateTime LastModified { get; set; }
        public int CollaboratorCount { get; set; }
        public bool IsShared { get; set; }
    }

    private sealed class ChatRoomInfo
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public int ParticipantCount { get; set; }
        public int UnreadCount { get; set; }
        public string LastMessage { get; set; } = "";
    }
}
