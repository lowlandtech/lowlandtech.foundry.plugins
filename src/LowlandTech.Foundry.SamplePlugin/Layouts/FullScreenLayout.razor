@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="@ThemeService.MudTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="fullscreen-layout">
    <MudAppBar Elevation="0" Dense="true" Color="Color.Transparent">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/"
                   Color="Color.Inherit">
            Back to Main
        </MudButton>
        <MudSpacer />
        <MudText Typo="Typo.h6">Full Screen Mode</MudText>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@ToggleDarkMode" />
        </MudTooltip>
    </MudAppBar>

    <div class="fullscreen-content">
        @Body
    </div>
</div>

<style>
    .fullscreen-layout {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .fullscreen-content {
        flex: 1;
        padding: 1rem;
    }
</style>

@code {
    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void ToggleDarkMode()
    {
        ThemeService.ToggleDarkMode();
    }

    private void HandleThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
