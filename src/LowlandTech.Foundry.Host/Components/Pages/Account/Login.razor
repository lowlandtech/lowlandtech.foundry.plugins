@page "/account/login"
@using LowlandTech.Foundry.Host.Services
@inject IAuthService AuthService
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - Foundry</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h4" Class="mb-4" Align="Align.Center">Sign In</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="Email is required"
                          Validation="@(new EmailAddressAttribute() { ErrorMessage = "Invalid email address" })"
                          Class="mb-4" />

            <MudTextField @bind-Value="_password"
                          Label="Password"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Password is required"
                          Class="mb-4" />

            <MudCheckBox @bind-Value="_rememberMe"
                         Label="Remember me"
                         Color="Color.Primary"
                         Class="mb-4" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(!_isValid || _isLoading)"
                       OnClick="HandleLogin"
                       Class="mb-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Sign In
            </MudButton>
        </MudForm>

        <MudDivider Class="my-4" />

        <MudText Align="Align.Center">
            Don't have an account?
            <MudLink Href="/account/register">Register here</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isValid;
    private bool _isLoading;
    private bool _rememberMe;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(_email, _password, _rememberMe);

            if (result.Success)
            {
                AuthStateProvider.NotifyAuthenticationStateChanged();
                Navigation.NavigateTo(ReturnUrl ?? "/");
            }
            else
            {
                _errorMessage = result.Error ?? "Login failed";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
